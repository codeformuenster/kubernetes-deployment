{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  customManagers: [
    {
      // CloudNativePG Cluster imageName
      customType: 'regex',
      managerFilePatterns: [
        '/\\.yaml$/',
      ],
      matchStrings: [
        'imageName: (?<depName>[^\\s:]+):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?',
      ],
      datasourceTemplate: 'docker',
      // matches: 17.6-202509151215-minimal-trixie
      versioningTemplate: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<patch>\\d+)-(?<compatibility>\\S+)$',
      autoReplaceStringTemplate: 'imageName: {{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}',
    }
  ],
  packageRules: [
    {
      matchPackageNames: ['ghcr.io/cloudnative-pg/postgresql'],
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },
    {
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "matchFileNames": [
        "apps/muenster-update/production/pgcluster.yaml"
      ],
      "groupName": "CloudNativePG PostgreSQL production",
      "groupSlug": "cloudnative-pg-postgresql-production",
      "commitMessageTopic": "Postgresql muenster-update production"
    },
    {
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "matchFileNames": [
        "apps/muenster-update/staging/pgcluster.yaml"
      ],
      "groupName": "CloudNativePG PostgreSQL staging",
      "groupSlug": "cloudnative-pg-postgresql-staging",
      "commitMessageTopic": "Postgresql muenster-update staging"
    }
  ]
}
